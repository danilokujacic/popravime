NODE_ENV=development
PORT=3000
# Comma-separated list of allowed frontend origins. Leave blank or "*" to allow any (dev only).
# Required (and must not be blank or "*") when NODE_ENV=production.
CORS_ORIGIN=
# Base URL of the frontend app (no trailing slash) — used to build deep links in emails, e.g. a
# provider's "view this request" link. Set to https://www.popravljaj.me in production.
FRONTEND_URL=http://localhost:3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=popravime
# Local Postgres (docker-compose) doesn't need TLS. Neon (and most managed Postgres) requires
# it — set this to true in production.
DATABASE_SSL=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis

JWT_SECRET=secret123
JWT_ACCESS_EXPIRES_IN_SECONDS=900
REFRESH_SECRET=refresh_secret123
JWT_REFRESH_EXPIRES_IN_SECONDS=604800

BCRYPT_SALT_ROUNDS=10

# MinIO locally, Cloudflare R2 in production (both S3-compatible).
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_URL=

# Maildev locally, real SMTP relay in production.
EMAIL_HOST=
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@popravime.me

THROTTLE_DEFAULT_LIMIT=100
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_AUTH_LIMIT=5
THROTTLE_AUTH_TTL_MS=60000
# POST /auth/refresh needs its own, more generous budget — it's called silently on every page
# load plus on every 401 retry, so it easily blows through THROTTLE_AUTH_LIMIT just from normal
# browsing, which was incorrectly bouncing signed-in users back to /login.
THROTTLE_REFRESH_LIMIT=30
THROTTLE_REFRESH_TTL_MS=60000
# GET /cities/lookup-by-coordinates hits Nominatim on every call — kept tight since our whole app
# shares one Nominatim User-Agent with a ~1 req/sec usage-policy budget.
THROTTLE_GEOCODING_LIMIT=20
THROTTLE_GEOCODING_TTL_MS=60000
THROTTLE_CONTACT_MESSAGE_LIMIT=3
THROTTLE_CONTACT_MESSAGE_TTL_MS=60000
# Endpoints that enqueue an email on every call — kept tight per-IP so a script can't cheaply
# spam offers/inquiries/requests/messages at scale.
THROTTLE_OFFER_CREATE_LIMIT=5
THROTTLE_OFFER_CREATE_TTL_MS=60000
THROTTLE_OFFER_STATUS_LIMIT=10
THROTTLE_OFFER_STATUS_TTL_MS=60000
THROTTLE_DIRECT_INQUIRY_LIMIT=5
THROTTLE_DIRECT_INQUIRY_TTL_MS=60000
THROTTLE_REPAIR_REQUEST_CREATE_LIMIT=5
THROTTLE_REPAIR_REQUEST_CREATE_TTL_MS=60000
THROTTLE_MESSAGE_LIMIT=20
THROTTLE_MESSAGE_TTL_MS=60000
# Per-recipient cap on transactional emails within the TTL window, regardless of which IP or
# account triggered them — catches a flood spread across many accounts/IPs that the per-endpoint
# throttles above can't see. Past the cap the email send is dropped (logged); the in-app
# notification is still created.
THROTTLE_EMAIL_RECIPIENT_LIMIT=20
THROTTLE_EMAIL_RECIPIENT_TTL_MS=3600000

# Nominatim (OpenStreetMap) usage policy requires an identifying User-Agent with a real contact.
GEOCODING_USER_AGENT=popravime-backend/1.0 (contact: ops@popravime.me)

# Bootstrap admin account, created idempotently by `pnpm run seed:run`.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Google/Facebook OAuth (§ auth). Leave blank in an environment that doesn't need social login —
# the app boots fine either way, but GET /auth/google or /auth/facebook will fail against the
# provider once actually used without real credentials. Get these from the Google Cloud Console
# / Meta for Developers, with the callback URLs below registered there exactly as set here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3001/auth/facebook/callback
# Where the browser is sent after a successful OAuth login, with a one-time ?code= appended —
# a frontend route that exchanges it via POST /auth/oauth/exchange. See FRONTEND_INTEGRATION.md.
OAUTH_FRONTEND_REDIRECT_URL=http://localhost:3000/auth/callback
OAUTH_EXCHANGE_CODE_TTL_SECONDS=60

# When true (default), only verified providers are visible in the public directory, can browse
# repair requests, and can submit offers. Set to false to let pending providers do all three
# during a free onboarding period. Rejected providers are always excluded either way.
VERIFICATION_REQUIRED=true

# How long a "confirm your email" link from POST /auth/register or /auth/resend-confirmation
# stays valid, in seconds. Default 24h.
EMAIL_CONFIRMATION_TTL_SECONDS=86400

# Admin login for the self-hosted Grafana container (docker-compose.yml's `grafana` service).
# Not read by the app itself. See DEPLOY.md.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
