NODE_ENV=development
PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=
JWT_ACCESS_EXPIRES_IN_SECONDS=900
REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN_SECONDS=604800

BCRYPT_SALT_ROUNDS=10

# MinIO locally, Cloudflare R2 in production (both S3-compatible).
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_URL=

# Maildev locally, real SMTP relay in production.
EMAIL_HOST=
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@popravime.me

THROTTLE_DEFAULT_LIMIT=100
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_AUTH_LIMIT=5
THROTTLE_AUTH_TTL_MS=60000

# Nominatim (OpenStreetMap) usage policy requires an identifying User-Agent with a real contact.
GEOCODING_USER_AGENT=popravime-backend/1.0 (contact: ops@popravime.me)

# Bootstrap admin account, created idempotently by `pnpm run seed:run`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
