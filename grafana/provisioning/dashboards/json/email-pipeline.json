{
  "title": "Email Pipeline",
  "uid": "popravime-email-pipeline",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "correlationId",
        "type": "textbox",
        "label": "Correlation ID",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Email pipeline logs (enqueue → pickup → provider result)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "{job=\"popravime-api\"} | json | emailKind != \"\"",
          "refId": "A"
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true }
    },
    {
      "id": 2,
      "title": "Email send failures",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 10 },
      "targets": [
        {
          "expr": "{job=\"popravime-api\"} | json | emailKind != \"\" | level >= 50",
          "refId": "A"
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true }
    },
    {
      "id": 3,
      "title": "All logs for one correlation ID",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 18 },
      "targets": [
        {
          "expr": "{job=\"popravime-api\"} | json | correlationId = \"$correlationId\"",
          "refId": "A"
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true }
    }
  ]
}
